{
  "name": "cpu-miner-app",
  "version": "0.1.0",
  "private": true,
  "description": "Unsigned FederationCoin CPU miner (RPC or Stratum v1). npm test is headless (Angular unit-test/jsdom, vitest, CPU hash fixtures). Live Electron block finds are laptop-only.",
  "author": "FederationCoin",
  "license": "MIT",
  "type": "module",
  "main": "out-electron/main.js",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "projects/miner-ui"
  ],
  "scripts": {
    "ng": "ng",
    "start": "npm run build:app && node native/gpu-hasher/rebuild.mjs && electron .",
    "start:web": "ng serve miner-web",
    "build": "npm run build:app",
    "build:web": "ng build miner-web --configuration production",
    "build:app": "ng build --configuration development && npm run build:electron",
    "fetch:extras": "node scripts/fetch-extras.mjs",
    "build:electron": "tsc -p miner/tsconfig.json && node --input-type=module -e \"import { copyFileSync, mkdirSync } from 'node:fs'; mkdirSync('out-electron',{recursive:true}); copyFileSync('miner/log.html','out-electron/log.html'); copyFileSync('build/icon.png','out-electron/icon.png')\" && node scripts/copy-federation-pool.mjs && node scripts/copy-extras.mjs",
    "build:gpu": "node native/gpu-hasher/rebuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && npm run test:miner && npm run test:gpu",
    "test:miner": "vitest run --config vitest.miner.config.ts",
    "test:live-electron": "node scripts/live-electron.mjs",
    "test:live-block": "node ../federation-pool/scripts/live-block-payouts.mjs --mode all",
    "test:gpu": "make -C native/gpu-hasher test",
    "dist": "npm run dist:linux",
    "dist:linux": "npm run build:app && npm run build:gpu && electron-builder --linux --publish never",
    "dist:win": "npm run build:app && node scripts/dist-win.mjs",
    "pack:win": "npm run build:app && node scripts/pack-win.mjs",
    "dist:mac": "npm run build:app && npm run build:gpu && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "canonicalize": "^2.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^4.0.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^12.4.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "org.federationcoin.cpuminer",
    "productName": "FederationCoin CPU Miner",
    "artifactName": "federationcoin-cpu-miner-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "icon": "build/icon.png",
    "asar": false,
    "forceCodeSigning": false,
    "npmRebuild": false,
    "publish": [],
    "extraResources": [
      {
        "from": "native/gpu-hasher/dist/",
        "to": "gpu-hasher",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/federation-pool/",
        "to": "federation-pool",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/federationcoind/",
        "to": "federationcoind",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/datum_gateway/",
        "to": "datum_gateway",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "out-electron/**/*",
      "dist/renderer/**/*",
      "package.json",
      "node_modules/@noble/hashes/**/*",
      "build/icon.png",
      "!**/electron.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "Utility",
      "synopsis": "Unsigned FederationCoin CPU miner (RPC or Stratum v1)"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "zip"
      ]
    },
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "zip"
      ]
    }
  }
}
